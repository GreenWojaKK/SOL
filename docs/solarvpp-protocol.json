  "input_common": {
    "time_features": "interval-midpoint clock hour sin/cos and delivery-day day-of-year sin/cos, XGB and DL, all input configs",
    "static_xgb": [
      "lat",
      "lon",
      "capacity_kw",
      "wa_dist",
      "wb_dist"
    ],
    "static_dl": [
      "lat",
      "lon",
      "capacity_kw"
    ],
    "fixed_across_inputs": [
      "night rule from solar geometry",
      "XGB power-curve target transform z - power_curve"
    ],
    "f0_removed_columns": [
      "solar position",
      "power_curve value",
      "sunup capacity share"
    ],
    "inactive_dl_blocks": "zero input with mask; same trunk size",
    "coordinates": "provided PV coordinates (shifted up to 2 km, rounded to 4 decimals) are used as is; station mapping and distances come from sites.csv"
  },
  "physics_proxy": {
    "clear_sky_ghi": "Haurwitz 1098*cosz*exp(-0.057/cosz) W/m2, 0 if cosz <= 0; one per PV and hour at the interval midpoint",
    "cloud_adjusted_irradiance": "G_cs*(1 - 0.75*c^3.4), c = cloud/100; per provider and round",
    "dew_point_spread": "T - T_d; wb uses forecast dew point, wa uses Magnus (a=17.62, b=243.12 C) from T and RH clipped to [1, 100] %; per provider and round",
    "temperature_derating": "1 - 0.004*(T_module - 25), T_module = T + 0.031*G; per provider and round",
    "xgb": "capacity-weighted mean and std over query members",
    "dl": "x_common in PV fusion (depends on PV coordinates through G_cs)",
    "learned": false
  },
  "loss_configs": {
    "pinball": {
      "loss": "capacity-weighted masked pinball (solarvpp-design.md#losses)"
    },
    "mae": {
      "aux": "mean |m - z|",
      "mask": "daylight valid hours, capacity-weighted as pinball"
    },
    "mse": {
      "aux": "mean (m - z)^2",
      "mask": "daylight valid hours, capacity-weighted as pinball"
    },
    "ramp": {
      "aux": "ramp",
      "formula": "mean_{t=2..24} |(m~_t - m~_{t-1}) - (z~_t - z~_{t-1})|",
      "mask": "profile"
    },
    "fourier": {
      "aux": "FAL",
      "formula": "mean_{k=0..12} (|rfft(m~)_k| - |rfft(z~)_k|)^2",
      "mask": "profile"
    },
    "cosine": {
      "aux": "cosine",
      "formula": "1 - <m~, z~>/(||m~|| ||z~|| + eps)",
      "mask": "profile",
      "note": "full-spectrum FCL equals cosine loss by Parseval; one cell"
    },
    "day-energy": {
      "aux": "day_energy",
      "formula": "abs(sum_h slot_weight_h * D_h * (q_0.5,h - z_h))",
      "mask": "complete 24-hour labels; daylight by solar geometry",
      "weighting": "query capacity C_A",
      "slot_weight": "same as main pinball: k for time_weight=settlement, otherwise 1",
      "lambda": "existing gradient-ratio calibration with r=0.1 by default",
      "daystate_energy_head_weight": 0,
      "daystate_observed_supervision": "retain throughout training"
    },
    "target_output": "DL median quantile m in normalized z units; XGB loss unchanged",
    "profile_mask": {
      "query_days": "complete 24-hour labels",
      "daylight": "solar-geometry mask, not Y > 0",
      "night": "prediction and target set to 0 (m~ = m*D, z~ = z*D)",
      "axis": "full 24 hours",
      "ramp_includes_sunrise_sunset": true,
      "cosine_excludes_all_zero_target": true,
      "weighting": "query capacity C_A",
      "l0_uses_incomplete_days": true
    }
  },
  "aux_lambda": {
    "method": "gradient_ratio_calibrated_once",
    "formula": "lambda_k = r * E||grad L_pinball|| / E||grad L_k||",
    "warmup_steps_l0_only": 200,
    "calibration_batches": 20,
    "calibration_point": "shared pinball checkpoint at step 200, next 20 scheduled batches, all parameters",
    "fixed_after_calibration": true,
    "total_steps": 2000,
    "aux_ratio_screening": 0.1,
    "r_policy": "grid values are defaults; any finite nonnegative r can be specified",
    "r_followup": [
      0.03,
      0.1,
      0.3
    ],
    "recorded_per": [
      "input_config",
      "seed"
    ]
  },
